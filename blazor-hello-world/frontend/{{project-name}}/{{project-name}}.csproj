<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Personalize the .NET assembly + root namespace from the `icp new` project name.
         `my-app` -> `MyApp`; this is what names the DLL and `MyApp.styles.css`. -->
    <AssemblyName>{{ project-name | pascal_case }}</AssemblyName>
    <RootNamespace>{{ project-name | pascal_case }}</RootNamespace>
  </PropertyGroup>

  <!-- Release: full publish with trimming -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>

  <!-- Debug: fast builds, no trimming -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

</Project>
