{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "bundler",  // required: @icp-sdk/core exposes bare subpaths (@icp-sdk/core/agent)
    // via a package "exports" map, which classic node10 resolution cannot see.
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist"
  },
  "include": [
    "src/**/*"
  ]
}
